# Python
__pycache__/
*.py[cod]
*$py.class
*.env
.anpr_token
venv/
.venv/

# Database & Runtime Data
*.db
*.sqlite3

# Output runtime (folder tetap ada lewat .gitkeep)
output/screenshots/*
!output/screenshots/.gitkeep
output/results/*
!output/results/.gitkeep
output/logs/*
!output/logs/.gitkeep
output/eval/
output/parking_history.json

# Ground truth lokal berlabel (jangan pernah di-commit ke git; hanya template kosong yang di-commit)
tools/eval/ground_truth.local.csv

# Bobot model (besar). File yang sudah dilacak git tetap dilacak.
models/**/*.pt
models/**/*.onnx

# Dataset training & data uji (besar)
datasets/*/*
!datasets/*/.gitkeep
test/videos/*
!test/videos/.gitkeep
test/images/*
test/scratch/

# Jupyter Notebooks & Scratch
*.ipynb
.ipynb_checkpoints/

# Local scratch & archives
scratch/
*.zip

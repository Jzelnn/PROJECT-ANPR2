# Python
__pycache__/
*.py[cod]
*$py.class
*.env
venv/
.venv/

# Database & Runtime Data
*.db
*.sqlite3

# Output runtime (folder tetap ada lewat .gitkeep)
output/screenshots/*
!output/screenshots/.gitkeep
output/results/*
!output/results/.gitkeep
output/logs/*
!output/logs/.gitkeep

# Bobot model (besar). File yang sudah dilacak git tetap dilacak.
models/**/*.pt

# Dataset training & data uji (besar)
datasets/*/*
!datasets/*/.gitkeep
test/videos/*
!test/videos/.gitkeep
test/images/*
test/scratch/

# Jupyter Notebooks & Scratch
*.ipynb
.ipynb_checkpoints/


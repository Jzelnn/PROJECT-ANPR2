# ========================================================
# KONFIGURASI KEAMANAN & ENVIRONMENT ANPR PARKIR RS
# Salin file ini menjadi `.env` (jangan pernah di-commit ke Git)
# ========================================================

# --- 1. Autentikasi API, Sesi Cookie, & WebSocket ---
# Wajib diisi jika ANPR_BIND_HOST bukan localhost (127.0.0.1), kecuali ANPR_AUTH_DISABLED=1.
ANPR_API_TOKEN=
# Kunci rahasia HMAC untuk menandatangani cookie sesi baca (anpr_session, kedaluwarsa 12 jam).
# Jika dikosongkan, server akan membangkitkan kunci acak baru setiap kali restart.
ANPR_SESSION_SECRET=
# Setel ANPR_COOKIE_SECURE=1 HANYA jika diakses melalui HTTPS (mis. di balik reverse proxy Nginx/Caddy).
# Pada jaringan LAN HTTP polos (tanpa TLS), biarkan 0 karena browser tidak mengirim cookie Secure di atas HTTP.
# PERINGATAN RISIKO HTTP POLOS: Pada jaringan LAN yang tidak tepercaya, trafik HTTP polos berisiko disadap (sniffing).
# Untuk produksi rumah sakit, disarankan memasang reverse proxy HTTPS (Nginx/Caddy) di depan port 5001 dan menyetel ANPR_COOKIE_SECURE=1.
ANPR_COOKIE_SECURE=0
# Setel ke 1 HANYA untuk pengembangan lokal di jaringan terisolasi tanpa token.
ANPR_AUTH_DISABLED=0
# Host bind server (default: 0.0.0.0 untuk akses LAN, atau 127.0.0.1 untuk lokal saja)
ANPR_BIND_HOST=0.0.0.0
ANPR_PORT=5001

# --- 2. Kredensial Kamera CCTV (Hikvision ISAPI / RTSP) ---
# Jangan pernah menaruh password asli di kode sumber atau HTML!
ANPR_CCTV_USER=admin
ANPR_CCTV_PASSWORD=

# --- 3. Pembatasan CORS & Origin WebSocket ---
# Daftar origin yang diizinkan (pisahkan dengan koma). Kosong = hanya same-origin.
ANPR_CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# --- 4. Pengaturan Performa & Lintas Arsitektur ---
# Otomatis mendeteksi ARM64 vs x86_64 bila dikosongkan
ANPR_PURE_ARM=
ANPR_TORCH_THREADS=
DISABLE_PADDLE=1
SKIP_WARMUP=1
